# Copy this file to .env and fill in your key (never commit .env)

# Which LLM answers the questions: "anthropic" (Claude, paid) or "openrouter" (free models)
LLM_PROVIDER=anthropic

# --- Claude (LLM_PROVIDER=anthropic) --- key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# ANSWER_MODEL=claude-sonnet-5-5
# REWRITE_MODEL=claude-haiku-5-5

# --- OpenRouter (LLM_PROVIDER=openrouter) --- free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Free models are often busy (429), so several are tried in order. Ids ending in ":free":
# https://openrouter.ai/models?max_price=0
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL=google/gemma-4-31b-it:free   # optional: put one model first

# Optional overrides
# MAX_PAGES=300
